{
  "name": "leanrig",
  "version": "0.4.1",
  "description": "Cut AI coding-agent token usage and API costs with subagent delegation: keep the premium model as coordinator and route routine work to cheaper, better-fit models. Installs safe, reversible cost-saving profiles with full rollback. Supports Claude Code and Codex",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "subagent-delegation",
    "token-usage",
    "token-optimization",
    "cost-optimization",
    "ai-coding-agent",
    "ccusage",
    "rate-limits",
    "context-window",
    "anthropic",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuanyongxigua/leanrig.git"
  },
  "homepage": "https://github.com/zhuanyongxigua/leanrig#readme",
  "bugs": {
    "url": "https://github.com/zhuanyongxigua/leanrig/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "leanrig": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "node --loader ts-node/esm src/index.ts",
    "e2e": "bash scripts/e2e.sh",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
